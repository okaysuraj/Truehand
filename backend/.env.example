# Local development only: activate SPRING_PROFILES_ACTIVE=local to read backend/.env.
# Production uses injected environment variables and SPRING_PROFILES_ACTIVE=prod.
SPRING_PROFILES_ACTIVE=local
PORT=8080
DATABASE_URL=jdbc:postgresql://localhost:5432/truehand
DATABASE_USERNAME=
DATABASE_PASSWORD=
DB_POOL_SIZE=10
# One-time legacy database adoption only; see README.md. Keep false for normal startup.
SPRING_FLYWAY_BASELINE_ON_MIGRATE=false
SPRING_FLYWAY_BASELINE_VERSION=1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8081
FRONTEND_BASE_URL=http://localhost:5173
# Prefer an external service-account file or workload identity; never commit the key.
GOOGLE_APPLICATION_CREDENTIALS=
FIREBASE_PROJECT_ID=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
CLOUDINARY_URL=
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
## Required for encrypted bank/PAN data; base64-encode exactly 32 random bytes.
## Store the production key in your secret manager and preserve it for recovery.
DATA_ENCRYPTION_KEY=

# Enable only after configuring and validating the actual SMTP/push providers.
NOTIFICATION_DISPATCH_ENABLED=false
NOTIFICATION_EMAIL_ENABLED=false
NOTIFICATION_PUSH_ENABLED=false
EXPO_ACCESS_TOKEN=

# Shared PostgreSQL budgets per authenticated account, per 60-second window.
API_REQUESTS_PER_MINUTE=300
MEDIA_REQUESTS_PER_MINUTE=20
PAYMENT_REQUESTS_PER_MINUTE=30
# Optional aggregate-health SMTP diagnostics; readiness uses application state and PostgreSQL.
MAIL_HEALTH_CHECK_ENABLED=false
