{
  "expo": {
    "name": "truehand-mobile",
    "slug": "truehand-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/web-app-manifest-512x512.png",
    "splash": {
      "image": "./assets/logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#fcf9f8"
    },
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#fcf9f8",
        "foregroundImage": "./assets/web-app-manifest-512x512.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "@stripe/stripe-react-native",
        {
          "merchantIdentifier": "merchant.com.truehand",
          "enableGooglePay": true
        }
      ],
      "expo-font"
    ]
  }
}
